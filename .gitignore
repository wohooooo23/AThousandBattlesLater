# Store Unity project source and documentation, excluding local editor state.
/*
!/.gitignore
!/README.md
!/TODO.md
!/HANDOFF.md
!/COMMIT_AUDIT.md
!/WFC_BRANCH_CALIBRATION.md
!/WFC_WALL_INTEGRATION.md
!/Assets/
!/Packages/
!/ProjectSettings/

# Keep Unity asset metadata; it is required to preserve GUID references.
!/**/*.meta

# Never admit generated Unity/editor/build output if it is later placed under an allowed folder.
**/[Ll]ibrary/
**/[Uu]serSettings/
**/[Tt]emp/
**/[Oo]bj/
**/[Bb]uild/
**/[Bb]uilds/
**/[Ll]ogs/
**/[Mm]emoryCaptures/
**/[Rr]ecordings/
**/.vs/
**/.idea/
**/.vscode/
**/*.csproj
**/*.sln
**/*.user
**/*.pidb
**/*.booproj
**/*.svd
**/*.pdb
**/*.mdb
**/*.opendb
**/*.VC.db
**/sysinfo.txt
**/crashlytics-build.properties

# Unity Test Framework may leave recovery scenes when a PlayMode run is interrupted.
/Assets/InitTestScene*.unity
/Assets/InitTestScene*.unity.meta
/Assets/_Recovery/
/Assets/_Recovery.meta
