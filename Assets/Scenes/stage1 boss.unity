  m_Script: {fileID: 11500000, guid: a3972ca2b04e59d419d3d4d580697341, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::StoryDialogueController
  sceneMode: 1
  heroBubble: {fileID: 440368789}
  bossBubble: {fileID: 1883000415}
  bossVisualRoot: {fileID: 1202576806}
  fadeOverlay: {fileID: 1745769653}
  victoryOverlay: {fileID: 159621877}
  openingLines: []
  firstEncounterLines: []
  bossIntroductionLines:
  - speaker: 1
    text: You...?
  - speaker: 0
    text: Me. I have come to settle an old debt.
  - speaker: 1
    text: So you finally came. You never could let go of what happened.
  - speaker: 1
    text: Your lord met a truly wretched end.
  - speaker: 0
    text: Do not dare speak of him!
  - speaker: 1
    text: Ha! Whether I have the right is yours to prove in battle!
  bossVictoryLines:
  - speaker: 1
    text: You have grown stronger. All those years of battle...
  - speaker: 0
    text: You did not kill my lord! Who are you?
  - speaker: 1
    text: ...and wiser, too. Your eyes have sharpened.
  - speaker: 1
    text: You are right. It was not me. Take the crimson rune you found and seek
      the truth.
  - speaker: 0
    text: ...
  - speaker: 0
    text: Then today, at last, the truth will be revealed.
  movementPrompt: "WASD / Arrow Keys \u2014 Move"
  combatPrompt: Press J to attack. Find treasure chests and press F to open them.
  doubleJumpPrompt: Press Space in midair to double-jump.
  dashPrompt: Press Shift while moving to dash.
