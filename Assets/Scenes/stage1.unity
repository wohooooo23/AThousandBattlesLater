  heroBubble: {fileID: 896010464}
  bossBubble: {fileID: 0}
  bossVisualRoot: {fileID: 0}
  fadeOverlay: {fileID: 1503720659}
  victoryOverlay: {fileID: 0}
  openingLines:
  - speaker: 0
    text: Decades have passed... and now I have returned.
  - speaker: 0
    text: Since that day, I have lost count of the battles I have fought.
  - speaker: 0
    text: Even on the quietest nights, I have never known a moment's rest.
  - speaker: 0
    text: Today, I have finally made my choice.
  - speaker: 0
    text: I will put the past to rest.
  firstEncounterLines:
  - speaker: 0
    text: These monsters again? How familiar.
  - speaker: 0
    text: "Time has rusted my blade\u2014and weathered its wielder."
  - speaker: 0
    text: I should find equipment worthy of the road ahead.
  bossIntroductionLines: []
  bossVictoryLines: []
  movementPrompt: "WASD / Arrow Keys \u2014 Move"
  combatPrompt: Press J to attack. Find treasure chests and press F to open them.
  doubleJumpPrompt: Press Space in midair to double-jump.
  dashPrompt: Press Shift while moving to dash.
